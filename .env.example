# ---- LLM providers (OpenAI-compatible endpoints) ----
# Qwen (Alibaba DashScope, OpenAI-compatible mode)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- Infra ----
DATABASE_URL=postgresql://quorum:quorum@localhost:5432/quorum
REDIS_URL=redis://localhost:6379

# ---- Web / Auth (Auth.js) ----
# Generate one with: openssl rand -base64 32
AUTH_SECRET=
# Optional Google OAuth (email magic-link works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
